  "queries": [
    {
      "name": "monthly",
      "sql": "select\n  order_month,\n  channel,\n  revenue,\n  gross_margin,\n  gross_margin_rate,\n  units\nfrom contoso.gold.monthly_sales\norder by order_month, channel\n"
    },
    {
      "name": "totals",
      "sql": "select\n  round(sum(revenue), 2) as revenue,\n  round(sum(gross_margin), 2) as gross_margin,\n  sum(units) as units\nfrom contoso.gold.monthly_sales\n"
    }
  ],
