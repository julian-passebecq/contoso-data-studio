{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/julian-passebecq/datapass-mosaicstudio/main/spec/concept/v1/concept-spec.schema.json",
  "title": "DataPass concept spec v1",
  "version": "1.0.0",
  "description": "One renderer-free description of an app or a cloud project (format \"datapass.concept-spec\", version 1). Layers are listed bottom to top with strictly increasing heights (gap ≥ 0.6); every id is unique across the document; node.layer, node.domain, flow.from, flow.to and annotation.target must name declared ids; at most one lake, on the bottom layer; at most 3 nodes per (layer, domain) cell; side domains come after main domains; a documented spec cites a source or evidence ref for every node. Unknown fields are allowed by this schema; readers ignore them with a warning. See spec/concept/v1/README.md.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "id",
    "title",
    "provenance",
    "note",
    "layers",
    "domains",
    "nodes",
    "flows"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 300
    },
    "format": {
      "const": "datapass.concept-spec"
    },
    "version": {
      "const": 1
    },
    "specVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "provenance": {
      "enum": [
        "synthetic",
        "documented"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "label",
          "height"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "height": {
            "type": "number",
            "minimum": 0,
            "maximum": 40
          },
          "role": {
            "enum": [
              "storage",
              "data",
              "compute",
              "serving",
              "experience",
              "delivery",
              "users"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "placement": {
            "enum": [
              "main",
              "side"
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "kind",
          "layer",
          "domain",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "kind": {
            "enum": [
              "app",
              "web-app",
              "browser",
              "api",
              "endpoint",
              "function",
              "sql-db",
              "database",
              "lake",
              "lakehouse",
              "warehouse",
              "eventhouse",
              "notebook",
              "pipeline",
              "stream",
              "queue",
              "producer",
              "library",
              "semantic-model",
              "report",
              "dashboard",
              "alert",
              "identity",
              "repo",
              "artifact",
              "ci-runner",
              "static-host",
              "user",
              "users",
              "device",
              "external"
            ]
          },
          "layer": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "domain": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "enum": [
              "active",
              "planned",
              "deprecated",
              "external"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "maxItems": 6
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "maxItems": 12
          }
        }
      },
      "minItems": 1,
      "maxItems": 40
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "kind": {
            "enum": [
              "data",
              "control",
              "auth"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "direction": {
            "enum": [
              "forward",
              "both"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                },
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            },
            "maxItems": 12
          }
        }
      },
      "maxItems": 64
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      },
      "maxItems": 6
    }
  }
}
